# From Salla Partners Portal → your app → App Keys
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=

# From Salla Partners Portal → your app → Webhooks/Notifications
# Confirm the exact verification scheme (Signature vs Token) before relying on it — see route.ts TODO.
SALLA_WEBHOOK_SECRET=

# Only needed if you ever use Custom Mode for local Postman testing (see lib/salla.ts).
SALLA_REDIRECT_URI=http://localhost:3000/api/auth/callback

# From Supabase project → Settings → API Keys (project "ramz-db").
# SUPABASE_SECRET_KEY bypasses Row Level Security — server-side only, never expose to the browser.
SUPABASE_URL=https://ykhnjiqnuimqgcsgtcxa.supabase.co
SUPABASE_SECRET_KEY=

# Public URL this app is deployed at (no trailing slash). Every generated QR
# code encodes "${APP_URL}/api/s/<id>" so scans route through here for
# tracking before redirecting to the real product page.
APP_URL=https://ramz-production-0c82.up.railway.app

# From Zid Partner Dashboard → your app → API Keys (General Settings step)
ZID_CLIENT_ID=
ZID_CLIENT_SECRET=

# Must exactly match the "Redirection URL" registered in the Zid Partner
# Dashboard (Application Details step) — Zid redirects the merchant's
# browser here with ?code=... after they approve install.
ZID_REDIRECT_URI=https://ramz-production-0c82.up.railway.app/api/oauth/zid/callback

# Optional. Zid's docs don't document a signature/secret scheme for
# webhooks the way Salla's "Token" strategy does — set this only if Zid's
# dashboard exposes a webhook secret/header to configure, then the handler
# in app/api/webhooks/zid/route.ts will enforce it. Left unset = accepted
# unverified (logged loudly each time).
ZID_WEBHOOK_SECRET=
